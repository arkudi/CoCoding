COCODING_DATABASE_URL=sqlite:///./data/cocoding.db
COCODING_FRONTEND_DIST=frontend/dist
COCODING_AGENT_HARD_STEP_LIMIT=50
COCODING_AGENT_MULTI_AGENT_ENABLED=true
